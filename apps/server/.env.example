# Hermes WebUI server configuration (development). Copy to .env and fill in.
# Real environment variables always win over this file.

# Hermes gateway (chat, sessions, runs, streaming, cron)
HERMES_BASE_URL=http://127.0.0.1:8642

# Hermes dashboard API (config, env, models, MCP, skills, messaging, ops).
# The session token is minted by the operator: set the same value in the
# dashboard service environment (HERMES_DASHBOARD_SESSION_TOKEN).
HERMES_DASHBOARD_URL=http://127.0.0.1:49173
HERMES_DASHBOARD_SESSION_TOKEN=change-me

# WebUI bind
HOST=127.0.0.1
PORT=8789
HERMES_API_KEY=change-me

# Sign-in. "hermes" (default): use the Hermes dashboard's own username and
# password (dashboard.basic_auth); the WebUI never stores the password and
# uses the dashboard session it gets at sign-in for Settings, so
# HERMES_DASHBOARD_SESSION_TOKEN is not needed. "local": a WebUI-owned account
# claimed once with the setup token written to the data directory.
HERMES_WEBUI_AUTH_MODE=hermes
HERMES_WEBUI_HERMES_AUTH_PROVIDER=basic
# Behind a reverse proxy on the same host, trust it for client IP and HTTPS:
# HERMES_WEBUI_TRUST_PROXY=127.0.0.1
