# Hermes WebUI server configuration (development). Copy to .env and fill in.
# Real environment variables always win over this file.

# Hermes gateway (chat, sessions, runs, streaming, cron)
HERMES_BASE_URL=http://127.0.0.1:8642

# Hermes dashboard API (config, env, models, MCP, skills, messaging, ops).
# The session token is minted by the operator: set the same value in the
# dashboard service environment (HERMES_DASHBOARD_SESSION_TOKEN).
HERMES_DASHBOARD_URL=http://127.0.0.1:49173
HERMES_DASHBOARD_SESSION_TOKEN=change-me

# WebUI bind
HOST=127.0.0.1
PORT=8789
